# Optional: forex, gold, stocks and indices. Never put this in browser code.
TWELVE_DATA_API_KEY=
PORT=8765
# Saved candles live here; ignored by Git.
DATA_DIRECTORY=./data
# Optional additional subscriptions; up to 12. Format: provider:symbol:minutes
WATCHLIST=kraken:XBTUSD:60
# Optional local Niblit conversation backend. Only local HTTP endpoints are used.
PIP_MODEL_URL=http://127.0.0.1:8000/v1/chat/completions
PIP_MODEL=local
